---
import "@fancyapps/ui/dist/fancybox/fancybox.css";
// Fuentes autoalojadas (sin peticiones a terceros): serifa para nombre y
// títulos, sans para el texto y mono para fechas, datos y menú.
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource-variable/geist/index.css";
import "@fontsource-variable/geist-mono/index.css";
import instrumentSerif from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import instrumentSerifItalic from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url";
import geist from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMono from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import '../globals.css';
import CV from "@cv";
import { versioned } from "@/lib/versioned";
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
}

const { title } = Astro.props;

const { image, summary, url } = CV.basics;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Aplica el tema elegido con el interruptor antes del primer pintado,
      // para que no haya un parpadeo claro/oscuro. Sin elección guardada,
      // manda prefers-color-scheme desde el CSS.
      try {
        var theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
        }
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={summary} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon"/>
    <link rel="preload" as="image" href={versioned(image)} />
    {/* Solo los subconjuntos latinos (cubren el español): lo que se ve al
        cargar. El resto de la familia se pide si hace falta. */}
    {[instrumentSerif, instrumentSerifItalic, geist, geistMono].map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />
    ))}
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:image" content="" />
    <meta name="referrer" content="no-referrer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={url.split("//")[1] ?? ""} />
    <meta property="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content="" />
    {CV?.analyticsCode && <script is:inline src={CV.analyticsCode} />}
    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>
