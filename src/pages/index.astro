---
import Layout from "@layouts/Layout.astro";

import About from "@/components/sections/About.astro";
import Education from "@/components/sections/Education.astro";
import Experience from "@/components/sections/Experience.astro";
import Hero from "@/components/sections/Hero.astro";
import Projects from "@/components/sections/Projects.astro";
import Skills from "@/components/sections/Skills.astro";
import SectionNav from "@/components/SectionNav.astro";
import ThemeSwitch from "@/components/ThemeSwitch.astro";
import { SECTION_TITLES, slugify } from "@/lib/sections";

import CV, { basics } from "@cv";
const { name } = basics;

// Entradas del menú lateral, en el orden de la página y solo para las secciones
// que se pintan (las mismas condiciones que en <main>). "Inicio" es la cabecera.
const section = (title: string) => ({ id: slugify(title), label: title });
const menuItems = [
  { id: "inicio", label: "Inicio" },
  section(SECTION_TITLES.about),
  section(SECTION_TITLES.experience),
  section(SECTION_TITLES.projects),
  ...(CV?.education
    ? [
        section(SECTION_TITLES.education),
        ...(CV.certificates?.length > 0
          ? [section(SECTION_TITLES.certificates)]
          : []),
      ]
    : []),
  section(SECTION_TITLES.skills),
];
---

<Layout title={`${name} - Portfolio`}>
  <a
    href="#contenido"
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:border focus:border-skin-hue focus:bg-skin-fill focus:px-3 focus:py-2"
  >
    Saltar al contenido
  </a>

  <div
    id="inicio"
    class="relative mx-auto w-full max-w-3xl px-4 py-8 sm:px-6 sm:py-12 print:max-w-none print:p-0"
  >
    <SectionNav items={menuItems} />

    <header class="flex flex-col gap-6">
      <div class="flex justify-end print:hidden">
        <ThemeSwitch />
      </div>
      <Hero />
    </header>

    <main
      id="contenido"
      tabindex="-1"
      class="mt-12 flex flex-col gap-12 focus:outline-none print:mt-6 print:gap-6"
    >
      <About />
      <Experience />
      <Projects className="print:hidden" />
      {CV?.education && <Education />}
      <Skills />
    </main>

    <footer
      class="mt-16 flex items-center justify-between gap-4 border-t border-skin-muted pt-6 text-sm text-skin-muted print:hidden"
    >
      <p>© {new Date().getFullYear()} {name}</p>
      <a href="#inicio">Volver arriba</a>
    </footer>
  </div>
</Layout>
