---
// Menú de secciones para saltar rápido por una página larga.
//
// - Pantalla ancha (>= 1280px): raíl en el margen izquierdo, pegado a la
//   columna, que se queda fijo al hacer scroll.
// - Pantalla estrecha: no hay margen donde ponerlo, así que el mismo menú se
//   abre desde un botón flotante (API Popover del navegador: se cierra con Esc
//   o al tocar fuera, sin JavaScript propio).
//
// Sin JavaScript siguen funcionando los enlaces ancla; el script solo añade la
// sección activa mientras se hace scroll.
import { Icon } from 'astro-icon/components'

interface Props {
  items: { id: string; label: string }[]
}

const { items } = Astro.props
---

<div class="rail">
  <nav aria-label="Secciones">
    <ul>
      {
        items.map(({ id, label }) => (
          <li>
            <a href={`#${id}`} class="section-link font-mono" data-section-link={id}>
              <span class="tick" aria-hidden="true" />
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<button
  type="button"
  class="menu-button"
  popovertarget="menu-secciones"
  aria-label="Abrir el menú de secciones"
>
  <Icon name="ri:menu-2-line" width={20} height={20} aria-hidden="true" />
</button>

<nav id="menu-secciones" class="menu-popover" popover aria-label="Secciones">
  <ul>
    {
      items.map(({ id, label }) => (
        <li>
          <a href={`#${id}`} class="section-link font-mono" data-section-link={id}>
            <span class="tick" aria-hidden="true" />
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('a[data-section-link]')
  )

  // Si una sección no existe (p. ej. no hay certificaciones), su enlace sobra.
  for (const link of links) {
    if (!document.getElementById(link.dataset.sectionLink ?? '')) {
      link.closest('li')?.remove()
    }
  }

  const targets = [
    ...new Set(
      links
        .filter((link) => link.isConnected)
        .map((link) => link.dataset.sectionLink ?? '')
    ),
  ]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null)

  if (targets.length > 0) {
    const popover = document.getElementById('menu-secciones')
    let current = ''
    let locked = false
    let unlockTimer: number | undefined

    const setActive = (id: string) => {
      if (id === current) return
      current = id
      for (const link of links) {
        if (link.dataset.sectionLink === id) {
          link.setAttribute('aria-current', 'location')
        } else {
          link.removeAttribute('aria-current')
        }
      }
    }

    // La sección activa es la última cuyo borde superior ya ha pasado por una
    // línea cercana al borde superior de la ventana (la del scroll-margin de
    // las anclas más un poco de aire). Si fuera más baja, una sección corta
    // como "Sobre mí" cedería el turno a la siguiente nada más saltar a ella.
    // Al llegar al final de la página se marca la última, aunque sea
    // demasiado corta para llegar hasta la línea.
    const update = () => {
      if (locked) return
      const line = Math.min(window.innerHeight * 0.25, 160)
      const atBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 2

      let active = targets[0]
      for (const target of targets) {
        if (target.getBoundingClientRect().top <= line) active = target
      }
      if (atBottom) active = targets[targets.length - 1]

      setActive(active.id)
    }

    let ticking = false
    const onScroll = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(() => {
        ticking = false
        update()
      })
    }

    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll)

    // Al pulsar, la sección elegida se marca al instante y se ignora el scroll
    // hasta que termina el desplazamiento: así el resalte no recorre una a una
    // las secciones intermedias. Al terminar NO se recalcula: si la página se
    // acaba antes de poder subir esa sección arriba (p. ej. "Certificaciones"),
    // seguiría marcada la que elegiste y no la última. Se recalcula con el
    // siguiente scroll del usuario.
    //
    // Al llegar, la línea bajo el título de la sección se oscurece y se
    // desvanece (clase .landed, solo cambia de color): marca dónde has
    // aterrizado también cuando el salto es instantáneo.
    const land = (id: string) => {
      const heading = document.getElementById(id)?.querySelector('h2')
      if (!heading) return
      heading.classList.remove('landed')
      void heading.offsetWidth // reinicia la animación si se repite
      heading.classList.add('landed')
      heading.addEventListener(
        'animationend',
        () => heading.classList.remove('landed'),
        { once: true }
      )
    }

    for (const link of links) {
      link.addEventListener('click', () => {
        const id = link.dataset.sectionLink ?? ''
        setActive(id)
        locked = true

        const unlock = () => {
          if (!locked) return
          locked = false
          window.clearTimeout(unlockTimer)
          window.removeEventListener('scrollend', unlock)
          land(id)
        }
        window.clearTimeout(unlockTimer)
        window.addEventListener('scrollend', unlock, { once: true })
        unlockTimer = window.setTimeout(unlock, 800)

        if (popover?.matches(':popover-open')) popover.hidePopover()
      })
    }

    update()
  }
</script>

<style>
  /* --- Enlaces (comunes al raíl y al menú flotante) --- */
  .section-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.375rem;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: rgb(var(--color-text-muted));
    text-decoration: none;
    transition: color 250ms ease;
  }

  .tick {
    display: block;
    width: 0.75rem;
    height: 1px;
    background-color: currentColor;
    transition: width 450ms var(--ease-out);
  }

  .section-link:hover {
    color: rgb(var(--color-text-base));
  }
  .section-link:hover .tick {
    width: 1.25rem;
  }

  /* La sección activa va después de :hover para ganar si coinciden. */
  .section-link[aria-current='location'] {
    color: rgb(var(--color-text-base));
  }
  .section-link[aria-current='location'] .tick {
    width: 2rem;
  }

  /* --- Raíl en el margen izquierdo (pantalla ancha) --- */
  .rail {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    right: 100%;
    width: 11rem;
    margin-right: 2.5rem;
    pointer-events: none;
  }
  .rail nav {
    position: sticky;
    top: 35vh;
    pointer-events: auto;
  }
  .rail ul,
  .menu-popover ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* --- Botón y menú flotantes (pantalla estrecha) --- */
  .menu-button {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(var(--color-text-base), 0.3);
    border-radius: 9999px;
    background-color: rgb(var(--color-fill));
    color: rgb(var(--color-text-base));
    transition: background-color 200ms ease;
  }
  .menu-button:hover {
    background-color: rgb(var(--color-button-muted));
  }

  .menu-popover {
    position: fixed;
    inset: auto auto 4.5rem 1rem;
    margin: 0;
    min-width: 13rem;
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    padding: 0.25rem 1.25rem;
    border: 1px solid rgba(var(--color-text-base), 0.25);
    border-radius: 0.75rem;
    background-color: rgb(var(--color-fill));
    color: rgb(var(--color-text-base));
    /* Sube y se funde al abrir; --lift es cuánto sube (0 si se pide menos movimiento). */
    --lift: 0.75rem;
    opacity: 0;
    transform: translateY(var(--lift));
    transition:
      opacity 220ms ease,
      transform 360ms var(--ease-out),
      display 360ms allow-discrete,
      overlay 360ms allow-discrete;
  }
  .menu-popover:popover-open {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .menu-popover:popover-open {
      opacity: 0;
      transform: translateY(var(--lift));
    }
  }
  /* Filas de 44px: tamaño cómodo para el dedo. */
  .menu-popover .section-link {
    padding-block: 0.75rem;
  }

  /* Con espacio de sobra, el raíl sustituye al botón. */
  @media (min-width: 1280px) {
    .rail {
      display: block;
    }
    .menu-button,
    .menu-popover {
      display: none;
    }
  }

  /* Sin la API Popover no hay forma de abrir el menú flotante: se oculta. */
  @supports not selector(:popover-open) {
    .menu-button,
    .menu-popover {
      display: none;
    }
  }

  /* Con "reducir movimiento" se quita todo lo que desplaza algo (la línea que
     crece, el menú que sube) y se conservan los fundidos de color y opacidad,
     que no producen sensación de movimiento. */
  @media (prefers-reduced-motion: reduce) {
    .tick {
      transition: none;
    }
    .menu-popover {
      --lift: 0px;
      transition:
        opacity 220ms ease,
        display 220ms allow-discrete,
        overlay 220ms allow-discrete;
    }
  }

  @media print {
    .rail,
    .menu-button,
    .menu-popover {
      display: none !important;
    }
  }
</style>
