---
import { Icon } from 'astro-icon/components'

// Interruptor claro/oscuro. Sin JavaScript no se muestra: el tema sigue
// entonces a prefers-color-scheme (ver src/globals.css).
//
// El icono muestra el modo al que se cambia: luna en claro, sol en oscuro. Lo
// alterna el CSS (variante dark:, que sigue prefers-color-scheme y data-theme),
// así que no hay parpadeo. El script solo mantiene la etiqueta accesible.
//
// Al botón no se le pone ninguna clase de display: pisaría el atributo hidden.
---

<button
  id="theme-toggle"
  type="button"
  hidden
  aria-label="Cambiar a modo oscuro"
  title="Cambiar a modo oscuro"
  class="p-2 text-skin-muted hover:text-skin-base print:hidden"
>
  <Icon name="ri:moon-line" width={20} height={20} class="block dark:hidden" aria-hidden="true" />
  <Icon name="ri:sun-line" width={20} height={20} class="hidden dark:block" aria-hidden="true" />
</button>

<script>
  const button = document.getElementById("theme-toggle");

  if (button) {
    const root = document.documentElement;
    const media = window.matchMedia("(prefers-color-scheme: dark)");

    // Un data-theme explícito (elegido con el botón) manda sobre el del sistema.
    const isDark = () =>
      root.dataset.theme ? root.dataset.theme === "dark" : media.matches;

    const render = () => {
      const label = isDark()
        ? "Cambiar a modo claro"
        : "Cambiar a modo oscuro";
      button.setAttribute("aria-label", label);
      button.title = label;
    };

    button.hidden = false;
    render();

    button.addEventListener("click", () => {
      const next = isDark() ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
      render();
    });

    // Si el usuario no ha elegido, sigue al sistema también en caliente.
    media.addEventListener("change", render);
  }
</script>
