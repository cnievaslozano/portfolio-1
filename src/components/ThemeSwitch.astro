---
// Interruptor claro/oscuro. Sin JavaScript no se muestra: el tema sigue
// entonces a prefers-color-scheme (ver src/globals.css).
---

<button
  id="theme-toggle"
  type="button"
  hidden
  class="text-sm text-skin-muted hover:text-skin-base print:hidden"
>
  Cambiar a modo oscuro
</button>

<script>
  const button = document.getElementById("theme-toggle");

  if (button) {
    const root = document.documentElement;
    const media = window.matchMedia("(prefers-color-scheme: dark)");

    // Un data-theme explícito (elegido con el botón) manda sobre el del sistema.
    const isDark = () =>
      root.dataset.theme ? root.dataset.theme === "dark" : media.matches;

    const render = () => {
      button.textContent = isDark()
        ? "Cambiar a modo claro"
        : "Cambiar a modo oscuro";
    };

    button.hidden = false;
    render();

    button.addEventListener("click", () => {
      const next = isDark() ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
      render();
    });

    // Si el usuario no ha elegido, sigue al sistema también en caliente.
    media.addEventListener("change", render);
  }
</script>
