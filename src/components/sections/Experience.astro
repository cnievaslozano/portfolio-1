---
import Section from '../Section.astro'
import { SECTION_TITLES } from '@/lib/sections'
import { work } from '@cv'

// Las fechas son "AAAA-MM-DD". Se leen como texto para que el huso horario
// no pueda mover el año ni el mes.
const parts = (date: string) => date.split('-').map(Number)

// Meses de calendario completos entre dos fechas.
const monthsBetween = (from: string, to: string | null) => {
  const [y1, m1, d1] = parts(from)
  const now = new Date()
  const [y2, m2, d2] = to ? parts(to) : [now.getFullYear(), now.getMonth() + 1, now.getDate()]
  return (y2 - y1) * 12 + (m2 - m1) - (d2 < d1 ? 1 : 0)
}

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`

const jobs = work.map((job) => {
  const total = Math.max(0, monthsBetween(job.startDate, job.endDate))
  const years = Math.floor(total / 12)
  const months = total % 12
  const duration =
    [years && plural(years, 'año', 'años'), months && plural(months, 'mes', 'meses')]
      .filter(Boolean)
      .join(' y ') || 'menos de 1 mes'

  return {
    ...job,
    startYear: parts(job.startDate)[0],
    endYear: job.endDate ? parts(job.endDate)[0] : null,
    duration,
    isoDuration: `P${years}Y${months}M`,
    place: [job.location, job.location_type].filter(Boolean).join(' · '),
    technologies: Object.keys(job.skills ?? {}),
  }
})
---

<Section className={Astro.props.className} title={SECTION_TITLES.experience}>
  <ol class="flex flex-col gap-10 print:gap-6">
    {
      jobs.map((job) => (
        <li class="flex flex-col gap-4 print:gap-2 print:break-inside-avoid">
          <div class="flex flex-col gap-1">
            <h3>{job.position}</h3>
            <p class="font-medium">
              {job.url ? (
                <a href={job.url} target="_blank" rel="noreferrer noopener">
                  {job.name}
                  <span class="sr-only"> (se abre en una pestaña nueva)</span>
                </a>
              ) : (
                job.name
              )}
            </p>
            <p class="font-mono text-[0.8125rem] text-skin-muted">
              <time datetime={job.startDate}>{job.startYear}</time> –{' '}
              {job.endYear ? <time datetime={job.endDate}>{job.endYear}</time> : 'Presente'}
              <span class="print:hidden">
                {' '}· <time datetime={job.isoDuration}>{job.duration}</time>
              </span>
              {job.place && <> · {job.place}</>}
            </p>
          </div>

          {
            Array.isArray(job.summary) ? (
              <ul class="list-disc space-y-1.5 pl-5">
                {job.summary.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            ) : (
              job.summary && <p>{job.summary}</p>
            )
          }

          {
            job.responsibilities && (
              <div class="flex flex-col gap-2">
                <h4>Responsabilidades</h4>
                <ul class="list-disc space-y-1.5 pl-5">
                  {job.responsibilities.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            job.achievements && (
              <div class="flex flex-col gap-2">
                <h4>Logros</h4>
                <ul class="list-disc space-y-1.5 pl-5">
                  {job.achievements.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            job.technologies.length > 0 && (
              <p class="font-mono text-[0.8125rem] text-skin-muted print:hidden">
                <span class="font-semibold text-skin-base">Tecnologías:</span>{' '}
                {job.technologies.join(', ')}
              </p>
            )
          }
        </li>
      ))
    }
  </ol>
</Section>
