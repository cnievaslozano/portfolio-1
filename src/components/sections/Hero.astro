---
import { basics } from '@cv'
import { Icon } from 'astro-icon/components'

const { name, label, image, location, email, profiles } = basics
const { city, region, address } = location
const place = `${address}, ${city}, ${region}`

// Solo los enlaces externos se abren en pestaña nueva; mailto: abre el correo.
const isExternal = (url: string) => /^https?:/.test(url)
const isMail = (url: string) => url.startsWith('mailto:')
---

<div class="flex flex-col gap-6">
  <div class="flex items-center gap-5">
    <img
      src={image}
      alt={`Foto de ${name}`}
      width={96}
      height={96}
      loading="eager"
      class="size-24 shrink-0 object-cover print:hidden"
    />
    <div class="flex flex-col gap-1">
      <h1>{name}</h1>
      <p class="text-lg text-skin-muted">{label}</p>
      <p class="text-sm text-skin-muted">{place}</p>
      <p class="hidden text-sm print:block"><b>Contacto:</b> {email}</p>
    </div>
  </div>

  <ul
    aria-label="Perfiles y contacto"
    class="flex flex-wrap items-center gap-x-6 gap-y-2 print:hidden"
  >
    {
      profiles.map(({ network, url, icon }) => (
        <li class="flex items-center gap-3">
          <a
            href={url}
            class="inline-flex items-center gap-2"
            data-umami-event={`${network} click`}
            {...(isExternal(url)
              ? { target: '_blank', rel: 'noreferrer noopener' }
              : {})}
          >
            <Icon name={icon} width={20} height={20} aria-hidden="true" />
            {/* En el correo se ve la dirección, para poder leerla y copiarla. */}
            <span>{isMail(url) ? url.slice('mailto:'.length) : network}</span>
            {isExternal(url) && (
              <span class="sr-only"> (se abre en una pestaña nueva)</span>
            )}
          </a>
          {isMail(url) && (
            <>
              {/* mailto: no hace nada sin una app de correo configurada; copiar sí. */}
              <button
                type="button"
                hidden
                data-copy={url.slice('mailto:'.length)}
                class="text-sm text-skin-muted underline underline-offset-4 hover:text-skin-base"
              >
                Copiar
              </button>
              <span class="sr-only" role="status" data-copy-status />
            </>
          )}
        </li>
      ))
    }
  </ul>
</div>

<script>
  // Copia al portapapeles. La API moderna solo existe en contextos seguros y
  // puede estar bloqueada (p. ej. en un iframe); en ese caso se usa el método
  // clásico con un textarea temporal.
  const copyText = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text)
      return true
    } catch {}

    const area = document.createElement('textarea')
    area.value = text
    area.setAttribute('readonly', '')
    area.style.position = 'fixed'
    area.style.opacity = '0'
    document.body.appendChild(area)
    area.select()

    let copied = false
    try {
      copied = document.execCommand('copy')
    } catch {}
    area.remove()
    return copied
  }

  // Sin JavaScript el botón no se muestra y queda el enlace mailto:.
  document
    .querySelectorAll<HTMLButtonElement>('button[data-copy]')
    .forEach((button) => {
      const status = button.parentElement?.querySelector('[data-copy-status]')
      const label = button.textContent
      button.hidden = false

      button.addEventListener('click', async () => {
        const copied = await copyText(button.dataset.copy ?? '')
        button.focus()
        button.textContent = copied ? 'Copiado' : 'No se pudo copiar'
        if (status) {
          status.textContent = copied ? 'Dirección de correo copiada.' : ''
        }

        setTimeout(() => {
          button.textContent = label
          if (status) status.textContent = ''
        }, 2000)
      })
    })
</script>
